# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value
HOMEPAGE_WIDGET_PASSWORD=CHANGE_ME

# SECRET - set a strong value
MARIADB_ALLOW_EMPTY_PASSWORD=CHANGE_ME

# SECRET - set a strong value
MARIADB_PASSWORD=CHANGE_ME

# SECRET - set a strong value
MARIADB_RANDOM_ROOT_PASSWORD=CHANGE_ME

# SECRET - set a strong value
MARIADB_ROOT_PASSWORD=CHANGE_ME

# SECRET - set a strong value
MYSQL_PASSWORD=CHANGE_ME

# SECRET - set a strong value
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# REQUIRED - set for your environment
TRUSTED_PROXIES=CHANGE_ME

# default: admin
HOMEPAGE_WIDGET_USERNAME=admin

# SECRET - set a strong value (must match the POSTGRES_* values)
MARIADB_DATABASE=CHANGE_ME

# default: nextcloud
MARIADB_USER=nextcloud

# default: admin
NEXTCLOUD_ADMIN_USER=admin
